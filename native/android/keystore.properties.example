# Copy this to keystore.properties in the same directory and fill it in.
# That file is git-ignored and must stay that way: a signing key in git
# history cannot be removed from clones that already have it.
#
# Generate the key first (one command, once, and never again):
#
#   keytool -genkey -v -keystore sprout-upload.jks -alias sprout \
#           -keyalg RSA -keysize 2048 -validity 10000
#
# keytool ships with the JDK that Android Studio installs. Put the .jks
# somewhere outside this repository and back it up somewhere you will still
# have in five years — Play ties your listing to this key, and losing it
# means you cannot ship an update to your own app.

storeFile=C:/Users/you/keys/sprout-upload.jks
storePassword=
keyAlias=sprout
keyPassword=
