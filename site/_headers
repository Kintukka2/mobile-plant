# Cloudflare Pages reads this at the root of the published directory.
#
# The fonts are content-addressed only by name, so they are immutable in
# practice: a replaced face gets a new file in css/fonts/ and here together.
# Everything else is a page that must be allowed to change the moment it is
# republished, which is what no-cache buys — the browser still revalidates
# cheaply, it just never serves a stale policy or a stale price.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: geolocation=(), camera=(), microphone=(), interest-cohort=()

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# The walkthrough is 19MB across two formats, so a visitor who presses play
# should not pay for it twice. A week rather than a year and no immutable:
# these filenames are not content-addressed, and a replaced cut under the
# same name would otherwise be unreachable for everyone who had seen the old
# one. Long enough to matter, short enough to fix.
/video/*
  Cache-Control: public, max-age=604800

# The stylesheet needs the same policy as the pages, and learning that cost a
# broken landing page. /*.html was no-cache and site.css was not, so a
# returning reader could hold a stylesheet from before a change while getting
# the markup from after it — new elements, none of their rules. The walkthrough
# video shipped that way and rendered at its full 1920px inside a 390px phone,
# because with no CSS to size it the browser fell back to the width attribute.
# New markup with old rules is the failure this prevents; the ?v= on the link
# is what reaches the people already holding a stale copy.
/*.css
  Cache-Control: public, max-age=0, must-revalidate

/*.html
  Cache-Control: public, max-age=0, must-revalidate
